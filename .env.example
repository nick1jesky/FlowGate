# Скопируй в .env и подставь свои значения при желании (docker-compose
# читает .env автоматически). Значения ниже - дефолты из docker-compose.yml.

WORKERS_COUNT=5
CHANNEL_BUFFER=100

DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s

REDIS_DB=0
REDIS_DIAL_TIMEOUT=2s
REDIS_READ_TIMEOUT=500ms
REDIS_WRITE_TIMEOUT=500ms
REDIS_POOL_SIZE=20
REDIS_PING_TIMEOUT=2s

# Таймаут постановки в очередь ingest (backpressure) - если очередь забита
# дольше этого времени, клиент получает 503.
INGEST_SUBMIT_TIMEOUT=100ms
# Таймаут на один flush (BulkInsert) накопленного батча в БД.
INGEST_TASK_TIMEOUT=5s
INGEST_SHUTDOWN_TIMEOUT=10s
# Микробатчинг: сброс батча по достижении этого числа точек ЛИБО по
# истечении MAX_DELAY - что раньше. Компромисс throughput/задержка.
INGEST_BATCH_MAX_SIZE=500
INGEST_BATCH_MAX_DELAY=200ms
# Ретраи перед dead-letter: MAX_RETRIES попыток с линейно растущим
# бэкоффом (BACKOFF * номер_попытки), затем батч уходит в DLQ-файл.
INGEST_FLUSH_MAX_RETRIES=3
INGEST_FLUSH_RETRY_BACKOFF=200ms
INGEST_DLQ_PATH=./data/dlq/flowgate-dlq.jsonl

CACHE_TTL=60s
CACHE_STALE_AFTER=30s
CACHE_REFRESH_TIMEOUT=5s

HTTP_SHUTDOWN_TIMEOUT=5s

# Материализованное представление agg_metrics_1m - интервал рефреша
# адаптируется линейно между MIN (высокая нагрузка) и MAX (простой) по
# порогам скорости приёма в точках/сек. MV_RATE_REDIS_KEY - ключ, через
# который счётчик синхронизируется между несколькими инстансами flowgate
# (если Redis недоступен - используется только локальная скорость).
MV_VIEW_NAME=agg_metrics_1m
MV_REFRESH_MIN_INTERVAL=5s
MV_REFRESH_MAX_INTERVAL=60s
MV_REFRESH_HIGH_RATE_THRESHOLD=500
MV_REFRESH_LOW_RATE_THRESHOLD=50
MV_RATE_REDIS_KEY=flowgate:ingest:rate

# Безопасность API.
# API_KEYS - список через запятую (например "key1,key2"). Пусто - auth
# выключен (по умолчанию, для локальной разработки).
API_KEYS=
RATE_LIMIT_RPS=100
RATE_LIMIT_BURST=200
# TLS_CERT_FILE / TLS_KEY_FILE - пути к сертификату/ключу, если хочешь,
# чтобы flowgate сам терминировал TLS. Пусто - обычный HTTP (стандартный
# в проде вариант - терминировать TLS на ingress/reverse-proxy перед ним).
TLS_CERT_FILE=
TLS_KEY_FILE=
