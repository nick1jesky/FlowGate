# Скопируй в .env и подставь свои значения при желании (docker-compose
# читает .env автоматически). Значения ниже - дефолты из docker-compose.yml.

WORKERS_COUNT=5
CHANNEL_BUFFER=100

DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=30m
DB_MAX_CONN_IDLE_TIME=5m
DB_HEALTH_CHECK_PERIOD=1m
DB_CONNECT_TIMEOUT=5s

REDIS_DB=0
REDIS_DIAL_TIMEOUT=2s
REDIS_READ_TIMEOUT=500ms
REDIS_WRITE_TIMEOUT=500ms
REDIS_POOL_SIZE=20
REDIS_PING_TIMEOUT=2s

# Таймаут постановки в очередь ingest (backpressure) - если очередь забита
# дольше этого времени, клиент получает 503.
INGEST_SUBMIT_TIMEOUT=100ms
# Таймаут на обработку одной задачи воркером (BulkInsert), не привязан к
# HTTP-запросу, который её создал.
INGEST_TASK_TIMEOUT=5s
INGEST_SHUTDOWN_TIMEOUT=10s

CACHE_TTL=60s
CACHE_STALE_AFTER=30s
CACHE_REFRESH_TIMEOUT=5s

HTTP_SHUTDOWN_TIMEOUT=5s
